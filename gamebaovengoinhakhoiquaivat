UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Config.ToggleKey then
		Config.IsPulling = not Config.IsPulling
		if _G.MainToggleUpdate then _G.MainToggleUpdate(Config.IsPulling) end
		
		if Config.IsPulling then
			LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
		else
			LocalPlayer.CameraMode = Enum.CameraMode.Classic
		end
	end
end)

function clearESP()
	for _, inst in pairs(espInstances) do if inst then inst:Destroy() end end
	table.clear(espInstances)
end

local function drawESP(targetPart)
	if not targetPart or not targetPart.Parent then return end
	local character = targetPart.Parent
	
	-- ESP Highlight trên toàn thân (Highlight bắt buộc phải dán vào Model)
	if Config.EspHighlight and not character:FindFirstChild("ESPHighlight") then
		local hl = Instance.new("Highlight")
		hl.Name = "ESPHighlight"
		hl.FillColor = Theme.Accent
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.Parent = character
		table.insert(espInstances, hl)
	end
	
	-- ESP Box chỉ vẽ đúng trên HumanoidRootPart
	if Config.EspBox and not targetPart:FindFirstChild("ESPBox") then
		local box = Instance.new("BoxHandleAdornment")
		box.Name = "ESPBox"
		box.Size = targetPart.Size -- Box sát vào bộ phận
		box.Adornee = targetPart
		box.AlwaysOnTop = true
		box.ZIndex = 5
		box.Transparency = 0.5
		box.Color3 = Theme.Accent
		box.Parent = targetPart
		table.insert(espInstances, box)
	end
	
	-- ESP Line vẽ nối từ người chơi đến HumanoidRootPart của Mob
	if Config.EspLine and not targetPart:FindFirstChild("ESPLineAttach") then
		local myChar = LocalPlayer.Character
		if myChar and myChar:FindFirstChild("HumanoidRootPart") then
			local attach1 = Instance.new("Attachment", myChar.HumanoidRootPart)
			local attach2 = Instance.new("Attachment", targetPart)
			attach2.Name = "ESPLineAttach"
			
			local beam = Instance.new("Beam")
			beam.Name = "ESPLine"
			beam.Attachment0 = attach1
			beam.Attachment1 = attach2
			beam.FaceCamera = true
			beam.Color = ColorSequence.new(Theme.Accent)
			beam.Width0 = 0.05
			beam.Width1 = 0.05
			beam.Parent = targetPart
			
			table.insert(espInstances, attach1)
			table.insert(espInstances, attach2)
			table.insert(espInstances, beam)
		end
	end
end

-- ==========================================
-- CÔNG THỨC RENDERSTEPPED (SPEED & JUMP)
-- ==========================================
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid")
	if not hum then return end

	-- Xử lý Loop Speed (Áp dụng theo công thức cung cấp)
	if Config.LoopSpeed then
		if hum.WalkSpeed ~= Config.WalkSpeed then
			hum.WalkSpeed = Config.WalkSpeed
		end
	end

	-- Xử lý Loop Jump (Áp dụng theo công thức cung cấp)
	if Config.LoopJump then
		hum.UseJumpPower = true 
		if hum.JumpPower ~= Config.JumpPower then
			hum.JumpPower = Config.JumpPower
		end
	end
end)

-- Track Death & Respawn
LocalPlayer.CharacterAdded:Connect(function(char)
	if Config.AutoRespawn then
		task.wait(1) 
		Config.IsPulling = true
		if _G.MainToggleUpdate then _G.MainToggleUpdate(true) end
	end
	
	char:WaitForChild("Humanoid").Died:Connect(function()
		if char:FindFirstChild("HumanoidRootPart") then
			Config.LastDeathPosition = char.HumanoidRootPart.Position
		end
		Config.IsPulling = false
		if _G.MainToggleUpdate then _G.MainToggleUpdate(false) end
	end)
	
	if Config.AutoReturn and Config.LastDeathPosition then
		task.wait(0.5)
		if char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = CFrame.new(Config.LastDeathPosition)
		end
	end
end)

-- Vòng lặp tối ưu tìm mục tiêu ngầm
task.spawn(function()
	while true do
		task.wait(0.3)
		if Config.IsPulling or Config.EspLine or Config.EspBox or Config.EspHighlight then
			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				local temp = {}
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("BasePart") and obj.Name == Config.TargetPart and obj ~= myRoot and not obj:IsDescendantOf(LocalPlayer.Character) then
						local isPlayer = false
						for _, p in ipairs(Players:GetPlayers()) do if p.Character and obj:IsDescendantOf(p.Character) then isPlayer = true break end end
						
						if not isPlayer then
							local dist = (obj.Position - myRoot.Position).Magnitude
							if dist <= Config.Radius then table.insert(temp, obj) end
						end
					end
				end
				cachedNPCs = temp
			end
		end
	end
end)

