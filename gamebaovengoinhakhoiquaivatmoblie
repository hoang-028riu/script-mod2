local function createToggle(parent, text, configKey, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 38) -- Tăng chiều cao nhẹ để ngón tay dễ chạm
	frame.BackgroundColor3 = Theme.TabBG
