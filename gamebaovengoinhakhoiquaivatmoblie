local function showOverlayAlert(messageText, confirmCallback)
	isOverlayActive = true -- Chặn Auto Click ngay khi bắt đầu hiển thị thông báo
	overlayFrame.ZIndex = 110
	overlayFrame.Visible = true
	
	local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(overlayFrame, info, {BackgroundTransparency = 0.4})
	tween:Play()
	
	local alertBox = Instance.new("Frame")
	alertBox.Size = UDim2.new(0, 300, 0, 160)
	alertBox.Position = UDim2.new(0.5, -150, 0.4, -80)
	alertBox.BackgroundColor3 = Theme.MainBG
	alertBox.BorderSizePixel = 0
	alertBox.ZIndex = 111
	alertBox.Parent = overlayFrame
	
	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 8)
	boxCorner.Parent = alertBox
	
	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = SelectedThemeColor
	boxStroke.Thickness = 2
	boxStroke.Parent = alertBox
	registerThemeElement(boxStroke, "Color")
	
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, -20, 0, 70)
	textLabel.Position = UDim2.new(0, 10, 0, 15)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = messageText
	textLabel.TextColor3 = Theme.Text
	pcall(function() textLabel.Font = Enum.Font.GothamBold end)
	textLabel.TextSize = 13
	textLabel.TextWrapped = true
	textLabel.ZIndex = 112
	textLabel.Parent = alertBox
	
	local function createAlertButton(btnText, xOffset, isConfirm)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.4, 0, 0, 35)
		btn.Position = UDim2.new(0.1 + xOffset, 0, 0.65, 0)
		btn.BackgroundColor3 = isConfirm and SelectedThemeColor or Color3.fromRGB(60, 60, 60)
		btn.Text = btnText
		btn.TextColor3 = Theme.Text
		pcall(function() btn.Font = Enum.Font.GothamBold end)
		btn.TextSize = 12
		btn.ZIndex = 112
		btn.Parent = alertBox
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
		if isConfirm then registerThemeElement(btn, "BackgroundColor3") end
		
		btn.MouseButton1Click:Connect(function()
			isOverlayActive = false -- Mở lại Auto Click khi người dùng lựa chọn xong
			local fadeTween = TweenService:Create(overlayFrame, info, {BackgroundTransparency = 1})
			fadeTween:Play()
			fadeTween.Completed:Connect(function()
				overlayFrame.Visible = false
				overlayFrame.ZIndex = 80
				alertBox:Destroy()
			end)
			if isConfirm and confirmCallback then
				confirmCallback()
			end
		end)
	end
	
	if messageText == "BẠN MUỐN DÙNG VŨ KHÍ NÀO?" then
		createAlertButton("MELEE (CẬN CHIẾN)", 0, true)
		createAlertButton("GUN (SÚNG BẮN AX)", 0.4, false)
		
		alertBox:GetChildren()[3].MouseButton1Click:Connect(function()
			Config.WeaponType = "Melee"
			Config.MobDistance = 3
			hasChosenWeapon = true 
			if updateMobDistanceSlider then updateMobDistanceSlider(3) end
		end)
		alertBox:GetChildren()[4].MouseButton1Click:Connect(function()
			Config.WeaponType = "Gun"
			Config.MobDistance = 7
			hasChosenWeapon = true 
			if updateMobDistanceSlider then updateMobDistanceSlider(7) end
		end)
	else
		createAlertButton("ĐỒNG Ý", 0, true)
		createAlertButton("HỦY", 0.4, false)
	end
end

