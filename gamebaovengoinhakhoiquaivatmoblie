local function createMultiChoice(parent, text, configKey, options, customCallback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 60)
	frame.BackgroundColor3 = Theme.TabBG
	frame.ZIndex = 103
	frame.Parent = parent
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
	
	local subStroke = Instance.new("UIStroke")
	subStroke.Color = Color3.fromRGB(50, 50, 50)
	subStroke.Thickness = 1
	subStroke.Parent = frame
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 0, 20)
	label.Position = UDim2.new(0, 10, 0, 5)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Theme.Text
	pcall(function() label.Font = Enum.Font.Gotham end)
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 104
	label.Parent = frame
	
	local btnWidth = 1 / #options
	local btns = {}
	for i, opt in ipairs(options) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(btnWidth, -5, 0, 25)
		btn.Position = UDim2.new(btnWidth * (i - 1), 5, 0, 30)
		btn.BackgroundColor3 = Config[configKey] == opt and SelectedThemeColor or Color3.fromRGB(60, 60, 60)
		btn.Text = opt
		btn.TextColor3 = Theme.Text
		pcall(function() btn.Font = Enum.Font.GothamBold end)
		btn.TextSize = 11
		btn.ZIndex = 104
		btn.Parent = frame
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
		table.insert(btns, btn)
		if Config[configKey] == opt then registerThemeElement(btn, "BackgroundColor3") end
		
		btn.MouseButton1Click:Connect(function()
			Config[configKey] = opt
			for _, b in ipairs(btns) do 
				b.BackgroundColor3 = Color3.fromRGB(60, 60, 60) 
				ThemeElements[b] = nil
			end
			btn.BackgroundColor3 = SelectedThemeColor
			registerThemeElement(btn, "BackgroundColor3")
			if customCallback then customCallback(opt) end
		end)
	end
end

