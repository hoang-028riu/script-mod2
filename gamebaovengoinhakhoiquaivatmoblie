-- ==========================================
-- VÒNG LẶP TỐI ƯU HÓA: QUÉT QUÁI & LOOT CRATES (MOBILE PERFORMANCE STABLE)
-- ==========================================
task.spawn(function()
	while true do
		task.wait(0.35) -- Giãn cách nhẹ để điện thoại không bị quá nhiệt
		local char = LocalPlayer.Character
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		
		if myRoot then
			if Config.IsPulling or Config.EspLine or Config.EspBox or Config.EspHighlight then
				local temp = {}
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("BasePart") and obj.Name == Config.TargetPart and obj ~= myRoot and not obj:IsDescendantOf(char) then
						local isPlayer = false
						for _, p in ipairs(Players:GetPlayers()) do 
							if p.Character and obj:IsDescendantOf(p.Character) then isPlayer = true break end 
						end
						
						if not isPlayer then
							local dist = (obj.Position - myRoot.Position).Magnitude
							if dist <= Config.Radius then 
								table.insert(temp, obj) 
							end
						end
					end
				end
				cachedNPCs = temp
			end
			
			if Config.AutoLootCrates then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("BasePart") and obj.Name == "Phantom" then
						myRoot.CFrame = obj.CFrame
						task.wait(0.1)
					end
				end
			end
		end
	end
end)

-- ==========================================
-- VÒNG LẶP CHÍNH (HEARTBEAT): HÚT VÀ AIM BOT
-- ==========================================
local lastClickTime = 0

RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	
	local myRoot = char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	
	if Config.IsPulling then
		myRoot.Velocity = Vector3.new(myRoot.Velocity.X, 0, myRoot.Velocity.Z)
		myRoot.CFrame = CFrame.new(myRoot.Position.X, Config.CurrentSpawnY, myRoot.Position.Z)
		
		-- Auto click: Chỉ thực thi clicker khi biến isOverlayActive đạt giá trị false
		if Config.AutoFire and not isOverlayActive then
			local t = os.clock()
			if t - lastClickTime >= 0.1 then
				lastClickTime = t
				-- Giả lập touch cảm ứng lên màn hình thay cho nhấp chuột PC
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
				task.wait(0.01)
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
			end
		end
		
		local targetPos
		if Config.PositionMode == "Trên đầu" then
			targetPos = myRoot.Position + Vector3.new(0, Config.MobDistance, 0)
		else
			targetPos = myRoot.Position + (myRoot.CFrame.LookVector * Config.MobDistance)
		end
		
		local closestPart, minDist = nil, math.huge
		
		for _, part in ipairs(cachedNPCs) do
			if part and part.Parent then
				part.CFrame = CFrame.new(targetPos)
				local dist = (part.Position - myRoot.Position).Magnitude
				if dist < minDist then minDist = dist closestPart = part end
				
				drawESP(part)
			end
		end
		
		if Config.AimHead and closestPart then
			local cam = workspace.CurrentCamera
			if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, closestPart.Position) end
		end
	end
end)
