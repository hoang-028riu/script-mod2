-- Hàm cập nhật màu chủ đề mượt mà cho toàn bộ giao diện
local function updateThemeColor(newColor)
	SelectedThemeColor = newColor
	for element, prop in pairs(ThemeElements) do
		if element and element.Parent then
			pcall(function()
				local tInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				local tween = TweenService:Create(element, tInfo, {[prop] = newColor})
				tween:Play()
			end)
		else
			ThemeElements[element] = nil
		end
	end
end

-- Hàm đăng ký một UI Element để tự động thay đổi màu chủ đề
local function registerThemeElement(object, property)
	ThemeElements[object] = property
	object[property] = SelectedThemeColor
end

-- ==========================================
-- HÀM TRANG BỊ VÀ THẢ VŨ KHÍ TRỰC TIẾP TRÊN MOBILE
-- ==========================================
local function equipWeaponLogic()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	
	-- Tìm kiếm công cụ (Tool) đầu tiên trong balo để cầm ra
	local tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
	if tool then
		hum:EquipTool(tool)
	else
		-- Nếu đang cầm thì cất vũ khí đi
		hum:UnequipTools()
	end
end

