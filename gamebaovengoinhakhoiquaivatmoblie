LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(1)
	if Config.IsPulling or Config.AutoRespawn then
		equipWeaponLogic()
	end

	if Config.AutoRespawn then
		Config.IsPulling = true
		if _G.MainToggleUpdate then _G.MainToggleUpdate(true) end
		noticeLabel.Visible = true
		
		if char:FindFirstChild("HumanoidRootPart") then
			Config.CurrentSpawnY = char.HumanoidRootPart.Position.Y + Config.HeightOffset
		end
	end
	
	char:WaitForChild("Humanoid").Died:Connect(function()
		if char:FindFirstChild("HumanoidRootPart") then
			Config.LastDeathPosition = char.HumanoidRootPart.Position
		end
		Config.IsPulling = false
		if _G.MainToggleUpdate then _G.MainToggleUpdate(false) end
		noticeLabel.Visible = false
	end)
	
	if Config.AutoReturn and Config.LastDeathPosition then
		task.wait(0.5)
		if char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = CFrame.new(Config.LastDeathPosition)
			Config.CurrentSpawnY = Config.LastDeathPosition.Y 
		end
	end
end)

