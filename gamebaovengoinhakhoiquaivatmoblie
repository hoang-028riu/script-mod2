	subStroke.Thickness = 1
	subStroke.Parent = frame
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.7, 0, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Theme.Text
	pcall(function() label.Font = Enum.Font.Gotham end)
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 104
	label.Parent = frame
	
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 50, 0, 26)
	btn.Position = UDim2.new(1, -60, 0.5, -13)
	btn.BackgroundColor3 = Config[configKey] and SelectedThemeColor or Color3.fromRGB(60, 60, 60)
	btn.Text = Config[configKey] and "ON" or "OFF"
	btn.TextColor3 = Theme.Text
	pcall(function() btn.Font = Enum.Font.GothamBold end)
	btn.ZIndex = 104
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	if Config[configKey] then registerThemeElement(btn, "BackgroundColor3") end
	
	btn.MouseButton1Click:Connect(function()
		Config[configKey] = not Config[configKey]
		btn.Text = Config[configKey] and "ON" or "OFF"
		
		local targetColor = Config[configKey] and SelectedThemeColor or Color3.fromRGB(60, 60, 60)
		TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
		
		if Config[configKey] then
			registerThemeElement(btn, "BackgroundColor3")
		else
			ThemeElements[btn] = nil
		end
		
		if callback then callback(Config[configKey]) end
	end)
	
	if configKey == "IsPulling" then
		_G.MainToggleUpdate = function(state)
			btn.Text = state and "ON" or "OFF"
			local targetColor = state and SelectedThemeColor or Color3.fromRGB(60, 60, 60)
			TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
			if state then registerThemeElement(btn, "BackgroundColor3") else ThemeElements[btn] = nil end
		end
	end
end

local function createSlider(parent, text, configKey, min, max, isFloat, customCallback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 52) -- Tăng nhẹ kích thước slider cho mobile
	frame.BackgroundColor3 = Theme.TabBG
	frame.ZIndex = 103
	frame.Parent = parent
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
	
	local subStroke = Instance.new("UIStroke")
	subStroke.Color = Color3.fromRGB(50, 50, 50)
	subStroke.Thickness = 1
	subStroke.Parent = frame
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.7, 0, 0, 20)
	label.Position = UDim2.new(0, 10, 0, 4)
	label.BackgroundTransparency = 1
	label.Text = text .. ": " .. tostring(Config[configKey])
	label.TextColor3 = Theme.Text
	pcall(function() label.Font = Enum.Font.Gotham end)
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 104
	label.Parent = frame
	
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -20, 0, 10) -- Thanh trượt to hơn (10px) dễ vuốt cảm ứng
	bar.Position = UDim2.new(0, 10, 0, 32)
	bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	bar.ZIndex = 104
	bar.Parent = frame
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((Config[configKey] - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = SelectedThemeColor
	fill.ZIndex = 104
	fill.Parent = bar
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	registerThemeElement(fill, "BackgroundColor3")
	
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.ZIndex = 105
	btn.Parent = bar
	
	local dragging = false
	local function updateSlider(input)
		local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(pos, 0, 1, 0)
		local val = min + (pos * (max - min))
		val = isFloat and string.format("%.1f", val) or math.floor(val)
		Config[configKey] = tonumber(val)
		label.Text = text .. ": " .. val
		if customCallback then customCallback(Config[configKey]) end
	end
	
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true updateSlider(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end
	end)
	
	return function(newVal)
		Config[configKey] = newVal
		fill.Size = UDim2.new((newVal - min) / (max - min), 0, 1, 0)
		label.Text = text .. ": " .. newVal
	end
end

