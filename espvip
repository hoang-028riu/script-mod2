-- 🔄 CƠ CHẾ FIXLOST (AUTO-REEXECUTE ON TELEPORT)
-- ================================================================= --
local function HookTeleportFixLost()
    if not Settings.Auto_Reexecute then return end
    
    local queue_func = queue_on_teleport or 
                       (syn and syn.queue_on_teleport) or 
                       (fluxus and fluxus.queue_on_teleport) or 
                       (KRNL_LOADED and queue_on_teleport)

    if queue_func then
        -- Lưu lại nguồn script này để tự chạy lại
        local currentLoadstring = _G.CustomScriptLoadstring or [[
            -- Chạy lại chính xác bộ mã nguồn Visuals Pro này
            loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))() -- Ví dụ dự phòng
        ]]
        
        -- Thiết lập sự kiện OnTeleport để đẩy script vào hàng đợi khi chuyển server
        LocalPlayer.OnTeleport:Connect(function(state)
            queue_func(currentLoadstring)
        end)
    else
        warn("[FixLost]: Executor của bạn không hỗ trợ queue_on_teleport!")
    end
end

-- Kích hoạt FixLost ngay khi khởi chạy
