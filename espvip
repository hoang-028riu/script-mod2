RunService.RenderStepped:Connect(function()
    -- Tính toán màu RGB dựa trên thời gian thực (chu kỳ 6 giây đổi màu 1 vòng)
    local hue = (tick() % 6) / 6
    local rainbowColor = Color3.fromHSV(hue, 0.85, 1)
    Settings.Theme_Color = rainbowColor
    
    -- Cập nhật đồng bộ nền của Tab đang mở hoạt động
    for name, btn in pairs(TabButtons) do
        if Pages[name].Visible then
            btn.BackgroundColor3 = rainbowColor
        end
    end
    
    -- Cập nhật tất cả các viền/chữ có đăng ký RGB hoạt động
    for i = #RainbowElements, 1, -1 do
        local item = RainbowElements[i]
        if item.Instance and item.Instance.Parent then
            pcall(function()
                item.Instance[item.Property] = rainbowColor
            end)
        else
            table.remove(RainbowElements, i) -- Tự dọn dẹp nếu đối tượng bị hủy
        end
    end
end)


