if not _G.TeleportQueueManager then
    _G.TeleportQueueManager = {
        QueueFunc = queue_on_teleport or 
                    (syn and syn.queue_on_teleport) or 
                    (fluxus and fluxus.queue_on_teleport) or 
                    (KRNL_LOADED and queue_on_teleport),
        Scripts = {}, -- Danh sách các đoạn mã cần chạy ở server mới
        HasHooked = false,
        IsTeleporting = false
    }
end

local TeleportManager = _G.TeleportQueueManager

local function AutoExecuteOnTeleport(scriptString)
    if not TeleportManager.QueueFunc then
        warn("[TeleportManager]: Executor của bạn không hỗ trợ queue_on_teleport!")
        return false
    end

    -- Thêm mã nguồn vào danh sách quản lý tập trung để tránh trùng lặp
    table.insert(TeleportManager.Scripts, scriptString)

    if not TeleportManager.HasHooked then
        TeleportManager.HasHooked = true

        LocalPlayer.OnTeleport:Connect(function(teleportState)
            if TeleportManager.IsTeleporting then return end
            TeleportManager.IsTeleporting = true

            local CombinedScript = ""
            for i, code in ipairs(TeleportManager.Scripts) do
                -- Bọc mã nguồn trong task.spawn và pcall để đảm bảo chạy mượt và không lỗi
                CombinedScript = CombinedScript .. string.format([[
                    task.spawn(function()
                        local success, err = pcall(function()
                            %s
                        end)
                        if not success then
                            warn("Lỗi khi load lại script phần %d:", err)
                        end
                    end)
                ]], code, i)
            end

            TeleportManager.QueueFunc(CombinedScript)
        end)
    end
    return true
end

