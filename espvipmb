-- ================================================================= --
local function CleanPlayerESP(player)
    if ESP_Storage[player] then
        if ESP_Storage[player].Connections then
            for _, conn in ipairs(ESP_Storage[player].Connections) do
                pcall(function() conn:Disconnect() end)
            end
        end
        if ESP_Storage[player].Objects then
            for _, obj in pairs(ESP_Storage[player].Objects) do
                pcall(function()
                    if obj.Remove then obj:Remove() else obj:Destroy() end
                end)
            end
        end
        ESP_Storage[player] = nil
    end
end

local function ApplyESPToPlayer(player)
    if player == LocalPlayer then return end
    CleanPlayerESP(player)
    
    ESP_Storage[player] = {
        Objects = {},
        Connections = {}
    }
    
    local function onCharacterAdded(char)
        if ESP_Storage[player] and ESP_Storage[player].Objects then
            for _, obj in pairs(ESP_Storage[player].Objects) do
                pcall(function()
                    if obj.Remove then obj:Remove() else obj:Destroy() end
                end)
            end
            table.clear(ESP_Storage[player].Objects)
        end
        
        local objects = ESP_Storage[player] and ESP_Storage[player].Objects
        if not objects then return end
        
        -- 1. Chams
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.FillColor = player.TeamColor and player.TeamColor.Color or Color3.fromRGB(255, 50, 50)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0.1
        highlight.Enabled = Settings.Chams_Enabled
        highlight.Parent = char
        objects.Highlight = highlight

        -- 2. Billboard Name/Distance
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Billboard"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 100, 0, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = billboard
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = player.TeamColor and player.TeamColor.Color or Color3.fromRGB(255, 255, 255)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextSize = 11
        textLabel.Visible = Settings.Name_Enabled or Settings.Distance_Enabled
        objects.Label = textLabel
        objects.Billboard = billboard

        -- 3. Box ESP
        local boxBillboard = Instance.new("BillboardGui")
        boxBillboard.Name = "ESP_BoxBillboard"
        boxBillboard.AlwaysOnTop = true
        boxBillboard.Size = UDim2.new(4.2, 0, 5.6, 0)
        
        local boxFrame = Instance.new("Frame")
        boxFrame.Parent = boxBillboard
        boxFrame.Size = UDim2.new(1, 0, 1, 0)
        boxFrame.BackgroundTransparency = 1
        boxFrame.BorderColor3 = player.TeamColor and player.TeamColor.Color or Settings.Theme_Color
        boxFrame.BorderSizePixel = 1.5
        boxFrame.Visible = Settings.Box_Enabled
        
        local innerStroke = Instance.new("UIStroke")
        innerStroke.Color = Color3.fromRGB(0, 0, 0)
        innerStroke.Thickness = 0.5
        innerStroke.Parent = boxFrame
        objects.Box = boxBillboard

        -- 4. Tracers 
        local tracerLine
        if Drawing then
            tracerLine = Drawing.new("Line")
            tracerLine.Visible = false
            tracerLine.Color = player.TeamColor and player.TeamColor.Color or Settings.Theme_Color
            tracerLine.Thickness = 1.2
            tracerLine.Transparency = 0.8
            objects.Tracer = tracerLine
        end

        local renderConn
        renderConn = RunService.RenderStepped:Connect(function()
            if not player or not player.Parent or player.Character ~= char then
                renderConn:Disconnect()
                return
            end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local isFriendly = Settings.Team_Check and player.Team == LocalPlayer.Team
            
            if not hrp or not hum or hum.Health <= 0 or isFriendly then
                if billboard.Parent then billboard.Parent = nil end
                if boxBillboard.Parent then boxBillboard.Parent = nil end
                if highlight.Parent then highlight.Parent = nil end
                if tracerLine then tracerLine.Visible = false end
                return
            end

            if Settings.Chams_Enabled and Settings.ESP_Enabled then
                if highlight.Parent ~= char then highlight.Parent = char end
                highlight.Enabled = true
            else
                highlight.Enabled = false
            end

            if (Settings.Name_Enabled or Settings.Distance_Enabled) and Settings.ESP_Enabled then
                if billboard.Parent ~= hrp then billboard.Parent = hrp end
                textLabel.Visible = true
                
                local distance = math.clamp(math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0), 0, 99999)
                
                local textStr = ""
                if Settings.Name_Enabled then textStr = textStr .. player.DisplayName end
                if Settings.Distance_Enabled then textStr = textStr .. "\n[" .. distance .. "m]" end
                
                textLabel.Text = textStr
            else
                if billboard.Parent then billboard.Parent = nil end
            end

            if Settings.Box_Enabled and Settings.ESP_Enabled then
                if boxBillboard.Parent ~= hrp then boxBillboard.Parent = hrp end
                boxFrame.Visible = true
            else
                if boxBillboard.Parent then boxBillboard.Parent = nil end
            end

            if tracerLine then
                if Settings.Tracers_Enabled and Settings.ESP_Enabled then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        tracerLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tracerLine.To = Vector2.new(screenPos.X, screenPos.Y)
                        tracerLine.Visible = true
                    else
                        tracerLine.Visible = false
                    end
                else
                    tracerLine.Visible = false
                end
            end
        end)
        
        table.insert(ESP_Storage[player].Connections, renderConn)
    end
    
    local charAddedConn = player.CharacterAdded:Connect(onCharacterAdded)
    table.insert(ESP_Storage[player].Connections, charAddedConn)
    
    if player.Character then
        task.spawn(onCharacterAdded, player.Character)
    end
end

