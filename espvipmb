    local toastStroke = Instance.new("UIStroke")
    toastStroke.Color = Settings.Theme_Color
    toastStroke.Thickness = 1
    toastStroke.Transparency = 1
    toastStroke.Parent = toast
    RegisterRainbow(toastStroke, "Color")

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(0, 25, 1, 0)
    iconLabel.Position = UDim2.new(0, 6, 0, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = "📥"
    iconLabel.TextSize = 14
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconLabel.Parent = toast

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -35, 1, 0)
    textLabel.Position = UDim2.new(0, 31, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Text = player.DisplayName .. "\nđã vào server!"
    textLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    textLabel.TextSize = 10
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextTransparency = 1
    textLabel.Parent = toast

    TweenService:Create(toast, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0,
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()
    TweenService:Create(toastStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
    TweenService:Create(textLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

    task.delay(4, function()
        local fadeTween = TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(1.3, 0, 0, 0)
        })
