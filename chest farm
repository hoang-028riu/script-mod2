-- Định nghĩa hàm toggle ở đây (đã forward declare ở trên)
toggleFarmLogic = function(forceStart)
    if forceStart == true then
        isFarming = true
    elseif forceStart == false then
        isFarming = false
    else
        isFarming = not isFarming
    end

    if isFarming then
        afkFrame.Visible = true -- Hiện màn hình AFK
        hideAllGames() -- Reset về màn hình chọn Menu Game
        
        toggleBtn.Text = "ĐANG AUTO..."
        TweenService:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(50, 200, 80)}):Play()
        TweenService:Create(uiStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(50, 200, 80)}):Play()
        startFarmingLoop()
    else
        stopFarming()
    end
end

