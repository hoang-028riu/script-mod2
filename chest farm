local snakeRunning = false
local snakeBody = {}
local snakeDir = {x=1, y=0}
local nextSnakeDir = {x=1, y=0}
local snakeFood = {x=1, y=1}
local g2Cells = {}
local snakeScore = 0

-- Tạo grid
for y = 1, snakeGridSize do
    g2Cells[y] = {}
    for x = 1, snakeGridSize do
        local cell = Instance.new("Frame")
        cell.Size = UDim2.new(0, snakeCellPixels, 0, snakeCellPixels)
        cell.Position = UDim2.new(0, (x-1)*snakeCellPixels, 0, (y-1)*snakeCellPixels)
        cell.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        cell.BorderSizePixel = 1
        cell.BorderColor3 = Color3.fromRGB(40, 40, 45)
        cell.Parent = g2Container
        g2Cells[y][x] = cell
    end
end

local function drawSnake()
    for y = 1, snakeGridSize do
        for x = 1, snakeGridSize do
            if x == snakeFood.x and y == snakeFood.y then
                g2Cells[y][x].BackgroundColor3 = Color3.fromRGB(255, 50, 50) -- Food
            else
                g2Cells[y][x].BackgroundColor3 = Color3.fromRGB(30, 30, 35) -- BG
            end
        end
    end
    for i, part in ipairs(snakeBody) do
        if part.y >= 1 and part.y <= snakeGridSize and part.x >= 1 and part.x <= snakeGridSize then
            if i == 1 then
                g2Cells[part.y][part.x].BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Head
            else
                g2Cells[part.y][part.x].BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Body
            end
        end
    end
end

local function spawnFood()
    local valid = false
    while not valid do
        snakeFood = {x = math.random(1, snakeGridSize), y = math.random(1, snakeGridSize)}
        valid = true
        for _, p in ipairs(snakeBody) do
            if p.x == snakeFood.x and p.y == snakeFood.y then valid = false break end
        end
    end
end

local function resetSnake()
    snakeBody = {{x=math.floor(snakeGridSize/2), y=math.floor(snakeGridSize/2)}}
    snakeDir = {x=1, y=0}
    nextSnakeDir = {x=1, y=0}
    snakeScore = 0
    g2Title.Text = "Điểm: " .. snakeScore
    spawnFood()
end

local function startGame2()
    snakeRunning = true
    resetSnake()
    task.spawn(function()
        while snakeRunning do
            snakeDir = nextSnakeDir
            local head = snakeBody[1]
            local nx, ny = head.x + snakeDir.x, head.y + snakeDir.y

            -- Đụng tường hoặc đụng thân -> Thua
            local dead = false
            if nx < 1 or nx > snakeGridSize or ny < 1 or ny > snakeGridSize then dead = true end
            for _, p in ipairs(snakeBody) do
                if p.x == nx and p.y == ny then dead = true break end
            end

            if dead then
                g2Title.Text = "GAME OVER! Điểm: " .. snakeScore
                task.wait(1.5)
                if snakeRunning then resetSnake() end
            else
                table.insert(snakeBody, 1, {x=nx, y=ny})
                if nx == snakeFood.x and ny == snakeFood.y then
                    snakeScore = snakeScore + 10
                    g2Title.Text = "Điểm: " .. snakeScore
                    spawnFood()
                else
                    table.remove(snakeBody)
                end
                drawSnake()
            end
            task.wait(0.2) -- Tốc độ rắn
        end
    end)
end

