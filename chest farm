local toggleFarmLogic -- Forward declaration

-- Keyboard binding bao gồm cả Phím điều hướng trò rắn
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateInput(input)
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Xử lý bật/tắt menu
    if not isMobile and input.KeyCode == toggleKey and toggleFarmLogic then
        toggleFarmLogic()
    end

    -- Xử lý điều khiển Rắn (W A S D / Arrows)
    if game2Frame.Visible and snakeRunning then
        if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
            if snakeDir.y == 0 then nextSnakeDir = {x=0, y=-1} end
        elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
            if snakeDir.y == 0 then nextSnakeDir = {x=0, y=1} end
        elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
            if snakeDir.x == 0 then nextSnakeDir = {x=-1, y=0} end
        elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
            if snakeDir.x == 0 then nextSnakeDir = {x=1, y=0} end
        end
    end
end)

