                    g1Title.Text = "Số cần bấm: " .. currentTargetNum
                end
            else
                local originalColor = btn.BackgroundColor3
                btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                task.delay(0.2, function() btn.BackgroundColor3 = originalColor end)
            end
        end)
