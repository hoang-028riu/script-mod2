-- 6. LOGIC BAY & TÌM RƯƠNG
-- ==========================================
local function flyTo(targetPos, isIslandHop)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart

    local goalPos = targetPos + Vector3.new(0, 3, 0)
    local CHUNK_DISTANCE = 300
    local initialDistance = (hrp.Position - goalPos).Magnitude

    while isFarming do
        -- Đảm bảo nếu nhân vật chết lúc đang bay, vòng lặp bay sẽ huỷ để reset an toàn
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or player.Character.Humanoid.Health <= 0 then
            return false 
        end

        -- ĐÃ FIX CÚ PHÁP: Thay thế lệnh continue bằng cấu trúc if-else để tương thích 100% executor
        if isDodging then
            task.wait(0.1)
        else
            local currentPos = hrp.Position
            local distanceLeft = (currentPos - goalPos).Magnitude
            
            if distanceLeft <= 3 then break end

            if not noclipConnection then
                noclipConnection = RunService.Stepped:Connect(function()
                    if player.Character then
                        for _, part in ipairs(player.Character:GetDescendants()) do
                            if part:IsA("BasePart") and part.CanCollide then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end

            hrp.Anchored = true 
            local stepDist = math.min(CHUNK_DISTANCE, distanceLeft)
            local direction = (goalPos - currentPos).Unit
            local nextWaypoint = currentPos + (direction * stepDist)

            -- ĐÃ FIX LỖI NƯỚC BIỂN: Khi còn cách xa rương trên 50 stud, luôn ép độ cao là Y = 30 (Tuyệt đối an toàn khỏi nước biển)
            if distanceLeft > 50 and nextWaypoint.Y < 30 then
                nextWaypoint = Vector3.new(nextWaypoint.X, 30, nextWaypoint.Z)
            end

            -- Tốc độ dựa trên khoảng cách: > 2500 stud thì dùng 350, nhặt rương gần dùng ngẫu nhiên 750-1000
            local currentSpeed
            if initialDistance > 2500 or isIslandHop then
                currentSpeed = 350
            else
                currentSpeed = math.random(750, 1000)
            end
            
            local timeToTravel = stepDist / currentSpeed
            local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
            
            currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(nextWaypoint)})
            currentTween:Play()
            
            local completed = false
            local conn
            conn = currentTween.Completed:Connect(function(state) 
                completed = true 
            end)

            while not completed and isFarming and not isDodging do task.wait() end
            if conn then conn:Disconnect() end

            if not isFarming then break end

            if not isDodging and distanceLeft > CHUNK_DISTANCE then
                hrp.Anchored = false
                if noclipConnection then
                    noclipConnection:Disconnect()
                    noclipConnection = nil
                end
                task.wait(0.1) 
            end
        end
    end

    if isFarming and char and char:FindFirstChild("HumanoidRootPart") then
        hrp.Anchored = false
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        task.wait(0.5)
    end
    
    return true 
end

local function scanAndUpdateChests()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local typeName, cooldown = getChestInfo(obj.Name)
        if typeName then
            local pos = getChestPosition(obj)
            if pos then
                local key = getPosKey(pos)
                if not knownChests[key] then
                    knownChests[key] = { position = pos, type = typeName, cooldown = cooldown, readyTime = 0 }
                end
                -- Cấp phát ESP dựa vào ID key của bộ nhớ
                registerChestESP(obj, typeName, key)
            end
        end
    end
end

-- TỰ ĐỘNG REFRESH ESP/QUÉT RƯƠNG MỖI 5 GIÂY
task.spawn(function()
    while true do
        task.wait(5)
        pcall(function()
            scanAndUpdateChests()
        end)
    end
end)

-- CẬP NHẬT: Nhận tham số originPos. Quét rương trong vòng 2500 stud từ originPos
local function getNearestAvailableChest(originPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    -- Ưu tiên lấy tâm quét là originPos (vị trí rương cũ), nếu không có mới lấy vị trí nhân vật
    local scanOrigin = originPos or char.HumanoidRootPart.Position

    scanAndUpdateChests()

    local nearestKey, nearestData = nil, nil
    local minDistance = math.huge
    local currentTime = tick()

    for key, data in pairs(knownChests) do
        if currentTime >= data.readyTime then
            local dist = (data.position - scanOrigin).Magnitude
            if dist < minDistance and dist <= MAX_SCAN_RADIUS then
                minDistance = dist
                nearestKey = key
                nearestData = data
            end
        end
    end

    if nearestKey then return {key = nearestKey, data = nearestData} end
    return nil
end

