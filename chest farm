local function getPosKey(pos)
    return math.floor(pos.X/5) .. "," .. math.floor(pos.Y/5) .. "," .. math.floor(pos.Z/5)
end

local function getChestPosition(chest)
    if chest:IsA("BasePart") then return chest.Position end
    if chest:IsA("Model") and chest.PrimaryPart then return chest.PrimaryPart.Position end
    for _, part in ipairs(chest:GetDescendants()) do
        if part:IsA("BasePart") then return part.Position end
    end
    return nil
end

local function getChestInfo(name)
    name = string.lower(name)
    if string.find(name, "chest 3") or string.find(name, "chest3") then return "Diamond", 15 * 60
    elseif string.find(name, "chest 2") or string.find(name, "chest2") then return "Gold", 10 * 60
    elseif string.find(name, "chest 1") or string.find(name, "chest1") or string.find(name, "chest") then return "Silver", 5 * 60
    end
    return nil, nil
end

