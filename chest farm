local function activateHaki()
    task.wait(2) 
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.J, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.J, false, game)
    end)
    task.wait(0.5)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function onCharacterAdded(char)
    isDodging = false 
    task.spawn(activateHaki)
    
    local humanoid = char:WaitForChild("Humanoid", 10)
    if humanoid then
        local lastHealth = humanoid.Health
        humanoid.HealthChanged:Connect(function(newHealth)
            -- ĐÃ FIX: Bổ sung điều kiện (newHealth > 0) để không né đòn khi đang chết
            if newHealth > 0 and newHealth < lastHealth and isFarming and not isDodging then
                isDodging = true
                titleLabel.Text = "Bị đánh! Đang né đòn..."
                
                if currentTween then currentTween:Cancel() end
                
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Anchored = true 
                    -- Né đòn: Bay lên Y + 200
                    local dodgePos = hrp.Position + Vector3.new(0, 200, 0) 
                    local dodgeTween = TweenService:Create(hrp, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {CFrame = CFrame.new(dodgePos)})
                    currentTween = dodgeTween
                    dodgeTween:Play()
                    
                    task.spawn(function()
                        dodgeTween.Completed:Wait()
                        -- Chờ 1 giây trên không trung
                        task.wait(1) 
                        isDodging = false 
                    end)
                else
                    isDodging = false
                end
            end
            lastHealth = newHealth
        end)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
    task.spawn(function() onCharacterAdded(player.Character) end)
end

