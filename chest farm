-- 7. VÒNG LẶP START/STOP FARMING
-- ==========================================

local function stopFarming()
    isFarming = false
    isDodging = false
    
    afkFrame.Visible = false -- Tắt màn hình AFK
    hideAllGames() -- Dừng mọi trò chơi
    
    toggleBtn.Text = "BẬT AUTO CHEST"
    TweenService:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(220, 50, 50)}):Play()
    TweenService:Create(uiStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(60, 60, 70)}):Play()
    titleLabel.Text = "🍎 Auto Chest V2"

    if currentTween then currentTween:Cancel() currentTween = nil end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = false
        -- Reset góc quay để nhân vật không bị nằm chéo khi tắt Auto
        char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position) 
    end
end

local function startFarmingLoop()
    task.spawn(function()
        -- Khởi tạo biến lưu toạ độ rương vừa nhặt để quét tiếp
        local lastChestPosition = nil
        
        while isFarming do
            -- ĐÃ FIX CƠ CHẾ AUTO RESUME: Đợi an toàn khi nhân vật chết mà không làm hỏng vòng lặp
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or (char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0) then
                titleLabel.Text = "Đang chờ hồi sinh..."
                task.wait(1)
            else
                while isDodging do task.wait(0.5) end
                
                titleLabel.Text = "Đang tìm rương quanh đây..."
                local targetChest = getNearestAvailableChest(lastChestPosition)
                
                if targetChest then
                    titleLabel.Text = "Đang nhặt: " .. targetChest.data.type
                    local success = flyTo(targetChest.data.position, false)
                    
                    if not success then
                        titleLabel.Text = "Tạm bỏ rương, tìm rương khác..."
                        knownChests[targetChest.key].readyTime = tick() + 60
                        lastChestPosition = nil -- Reset tâm quét về lại nhân vật
                    else
                        if not isFarming then break end
                        task.wait(0.5) 
                        -- Đặt cooldown (Ghi vào bộ nhớ rương đã được farm)
                        knownChests[targetChest.key].readyTime = tick() + targetChest.data.cooldown
                        
                        -- LƯU VỊ TRÍ VỪA NHẶT làm tâm quét cho vòng lặp tiếp theo
                        lastChestPosition = targetChest.data.position
                    end
                else
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        -- Reset vị trí quét cũ vì đã hết rương quanh đây, chuẩn bị sang đảo mới
                        lastChestPosition = nil 
                        
                        -- Chuyển đổi đảo ngẫu nhiên
                        local targetIsland = islandCoords[math.random(1, #islandCoords)]
                        
                        titleLabel.Text = "Đang đổi đảo chờ rương..."
                        flyTo(targetIsland, true)
                        
                        if not isFarming then break end

                        local waitTime = math.random(5, 10)
                        titleLabel.Text = "Đang chờ load rương..."
                        
                        local elapsed = 0
                        while isFarming and elapsed < waitTime do
                            task.wait(1)
                            elapsed = elapsed + 1
                        end
                    end
                end
            end
        end
    end)
end

