espBtn.MouseButton1Click:Connect(function()
    isEspOn = not isEspOn
    if isEspOn then
        TweenService:Create(espBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 200, 80)}):Play()
    else
        TweenService:Create(espBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(220, 50, 50)}):Play()
    end
end)

local function getChestAdornee(chest)
    if chest:IsA("BasePart") then return chest end
    if chest:IsA("Model") and chest.PrimaryPart then return chest.PrimaryPart end
    for _, part in ipairs(chest:GetDescendants()) do
        if part:IsA("BasePart") then return part end
    end
    return nil
end

local function getChestColor(typeName)
    if typeName == "Diamond" then return Color3.fromRGB(0, 200, 255)
    elseif typeName == "Gold" then return Color3.fromRGB(255, 215, 0)
    else return Color3.fromRGB(200, 200, 200) end
end

local function registerChestESP(chest, typeName, key)
    if not activeEsps[chest] then
        local adornee = getChestAdornee(chest)
        if not adornee then return end

        local color = getChestColor(typeName)

        -- Tạo line nối từ màn hình
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.BackgroundColor3 = color
        line.BorderSizePixel = 0
        line.Visible = false
        line.Parent = linesFrame

        -- Tạo tên rương (BillboardGui)
        local bb = Instance.new("BillboardGui")
        bb.Adornee = adornee
        bb.Size = UDim2.new(0, 100, 0, 20)
        bb.AlwaysOnTop = true
        bb.Enabled = false
        
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = typeName
        txt.TextColor3 = color
        txt.TextStrokeTransparency = 0
        txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 12
        txt.Parent = bb
        bb.Parent = espFolder

        -- Lưu key để có thể đọc bộ nhớ cooldown từ knownChests
        activeEsps[chest] = { line = line, billboard = bb, key = key }
    end
end

RunService.RenderStepped:Connect(function(dt)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local bottomCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
    
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    -- THÊM LOGIC SPIN NHÂN VẬT (chạy độc lập, không cản trở di chuyển)
    if isFarming and hrp then
        currentSpin = (currentSpin + SPIN_SPEED * dt) % 360
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(currentSpin), 0)
    end
    
    for chest, espObj in pairs(activeEsps) do
        -- Kiểm tra xem rương đã bị farm (đang trong cooldown) chưa
        local isReady = true
        if espObj.key and knownChests[espObj.key] then
            if tick() < knownChests[espObj.key].readyTime then
                isReady = false
            end
        end

        local pos = chest and chest.Parent and getChestPosition(chest)
        local inRange = false
        if hrp and pos then
            if (pos - hrp.Position).Magnitude <= 2500 then
                inRange = true
            end
        end

        if not chest or not chest.Parent then
            -- Rương bị xoá hẳn -> gỡ ESP
            espObj.line:Destroy()
            espObj.billboard:Destroy()
            activeEsps[chest] = nil
        elseif not isEspOn or not isReady or not inRange or not pos then
            -- Nếu tắt ESP HOẶC rương chưa sẵn sàng HOẶC xa quá 2500 studs -> Ẩn ESP đi
            espObj.line.Visible = false
            espObj.billboard.Enabled = false
        else
            -- Hiển thị bình thường
            local screenPos, onScreen = camera:WorldToViewportPoint(pos)
            if onScreen then
                espObj.line.Visible = true
                espObj.billboard.Enabled = true

                local chestScreenPos = Vector2.new(screenPos.X, screenPos.Y)
                local distance = (bottomCenter - chestScreenPos).Magnitude
                
                espObj.line.Size = UDim2.new(0, distance, 0, 1)
                espObj.line.Position = UDim2.new(0, (bottomCenter.X + chestScreenPos.X) / 2, 0, (bottomCenter.Y + chestScreenPos.Y) / 2)
                espObj.line.Rotation = math.deg(math.atan2(chestScreenPos.Y - bottomCenter.Y, chestScreenPos.X - bottomCenter.X))
            else
                espObj.line.Visible = false
                espObj.billboard.Enabled = false
            end
        end
    end
end)

